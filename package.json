{
  "name": "orchestral-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Orchestral — capability routing, in-process semantic fallback, and an asset-handle protocol for AI media applications.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome lint .",
    "api:check": "pnpm -r --filter \"./packages/*\" exec api-extractor run",
    "api:update": "pnpm -r --filter \"./packages/*\" exec api-extractor run --local",
    "smoke:dist": "pnpm build && node scripts/smoke-dist.mjs",
    "docs:catalog": "node scripts/gen-pattern-catalog.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@vitest/coverage-v8": "^3.2.6",
    "tsdown": "^0.22.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
