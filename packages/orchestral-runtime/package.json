{
  "name": "@orchestral/runtime",
  "version": "0.2.0",
  "description": "In-process Runtime implementation for @orchestral/core. Submits jobs, dispatches Patterns through a CapabilityRouter, walks the model fallback chain when a call fails, and dedupes by idempotency key. Same-model transient retry and cross-Pattern Alternatives are opt-in. No durable queue — the host owns the lifecycle. Node-only (uses node:crypto); core itself is runtime-agnostic.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-runtime"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "agent-runtime",
    "job-orchestration",
    "capability-routing",
    "model-fallback",
    "idempotency",
    "human-in-the-loop",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@orchestral/core": "workspace:*"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@orchestral/discovery": "workspace:*",
    "@orchestral/patterns": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
