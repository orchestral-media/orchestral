{
  "name": "@orchestral/adapters-ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapters for @orchestral/core — wrap an AI SDK image / speech / transcription model instance as a ModelCapability envelope, so a host serves text-to-image, text-to-speech and automatic-speech-recognition without hand-writing a call adapter. Leaf package — nothing in @orchestral/* depends on it.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18"
  },
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-adapters-ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "orchestration",
    "capability-routing",
    "text-to-image",
    "text-to-speech",
    "speech-recognition",
    "adapter",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@orchestral/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@orchestral/patterns": "workspace:*",
    "@types/node": "^22.10.0",
    "ai": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
