{
  "name": "@orchestral/agent",
  "version": "0.3.0",
  "description": "Orchestral agent support — the first-party AgentPattern (the media orchestrator). Ships no agent loop and no provider SDK: the AgentRunImpl driving the loop is injected by the host. Optional extension; nothing in core/runtime/patterns depends on it.",
  "license": "Apache-2.0",
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-agent"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-pattern",
    "orchestration",
    "orchestral-pattern",
    "media-pipeline",
    "multimodal",
    "typescript"
  ],
  "orchestral": {
    "patterns": [
      {
        "id": "agent_orchestrator",
        "kind": "agent",
        "export": "createOrchestratorAgent"
      }
    ]
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@orchestral/core": "workspace:*",
    "@orchestral/patterns": "workspace:*"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
