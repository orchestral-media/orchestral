{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  "mainEntryPointFilePath": "<projectFolder>/dts/index.d.ts",

  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.api.json"
  },

  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc",
    "reportFileName": "agent.api.md"
  },

  "docModel": { "enabled": false },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/index.d.ts",
    "omitTrimmingComments": false
  },
  "tsdocMetadata": { "enabled": false },

  "messages": {
    "compilerMessageReporting": {
      "default": { "logLevel": "warning" }
    },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },
      "ae-missing-release-tag": { "logLevel": "none" },
      // Relaxed for this leaf pattern package, same as @orchestral/patterns:
      // every public Pattern type idiomatically `z.infer`s from a colocated
      // input schema and references a local `ASSET_NEEDS` const, so this rule
      // fires on the zod idiom rather than on real leaks. Kept strict (error)
      // in @orchestral/core and @orchestral/runtime, where a forgotten export
      // is a real vocabulary leak.
      "ae-forgotten-export": { "logLevel": "none", "addToApiReportFile": false }
    },
    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    }
  }
}
