{
  "name": "@orchestral/core",
  "version": "0.1.0",
  "description": "Orchestral core — substrate-agnostic Pattern / ModelCapability / Alternative vocabulary, Job / JobStore / CapabilityRouter / Runtime contracts, and in-memory defaults. No provider SDK, no execution engine.",
  "license": "Apache-2.0",
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-core"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "capability",
    "media",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
