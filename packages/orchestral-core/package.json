{
  "name": "@orchestral/core",
  "version": "0.4.0",
  "description": "Orchestral core — substrate-agnostic Pattern / ModelCapability / Alternative vocabulary and Job / JobStore / CapabilityRouter / Runtime contracts. The in-memory stores and the default router ship on their own entries (@orchestral/core/memory, @orchestral/core/routing). No provider SDK, no execution engine.",
  "license": "Apache-2.0",
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-core"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "capability-routing",
    "model-fallback",
    "pattern-registry",
    "json-schema",
    "multimodal",
    "typescript",
    "zod"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/memory.ts",
    "./routing": "./src/routing.ts"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./memory": {
        "types": "./dist/memory.d.ts",
        "import": "./dist/memory.js"
      },
      "./routing": {
        "types": "./dist/routing.d.ts",
        "import": "./dist/routing.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run && api-extractor run -c api-extractor.memory.json && api-extractor run -c api-extractor.routing.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
