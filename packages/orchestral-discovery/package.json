{
  "name": "@orchestral/discovery",
  "version": "0.1.0",
  "description": "Pattern discovery layer for @orchestral/core — a BM25 search index over a PatternRegistry plus the find_pattern tool handler that turns a free-form LLM query into ranked Pattern descriptors. Retrieval, not contract: core stays search-free.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "author": "MyPrototypeWhat <daoquqiexing@gmail.com>",
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-discovery"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "tool-discovery",
    "pattern-registry",
    "bm25",
    "search",
    "retrieval",
    "llm-tools",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && api-extractor run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@orchestral/core": "workspace:*",
    "minisearch": "^7.2.0"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
