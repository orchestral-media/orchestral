{
  "name": "@orchestral/dsh-plugin",
  "version": "0.0.1",
  "description": "Experimental DeepSeek Harness (dsh) bundle exposing orchestral media-generation Patterns as agent tools. Leaf bridge — orchestral never depends on this package.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18"
  },
  "homepage": "https://github.com/orchestral-media/orchestral#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchestral-media/orchestral.git",
    "directory": "packages/orchestral-dsh-plugin"
  },
  "bugs": {
    "url": "https://github.com/orchestral-media/orchestral/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "orchestral",
    "ai",
    "agents",
    "media-generation",
    "tools",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "NOTICE",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@orchestral/core": "workspace:*",
    "@orchestral/runtime": "workspace:*"
  },
  "peerDependencies": {
    "zod": ">=4.3 <5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@orchestral/patterns": "workspace:*",
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  }
}
